#!/usr/bin/env bash
# =============================================================================
# boki-tui-remove — remove a TUI app and its desktop entry
# =============================================================================

BOKI_USER="$(whoami)"
BOKI_HOME="/home/${BOKI_USER}"
APPS_DIR="${BOKI_HOME}/.local/share/applications"

echo
printf '  \e[1m%s\e[0m\n\n' 'arch-boki — Remove TUI'

# Find all desktop files we installed (identified by org.boki.tui. prefix)
mapfile -t TUI_DESKTOPS < <(find "$APPS_DIR" -name 'org.boki.tui.*.desktop' 2>/dev/null)

if [[ ${#TUI_DESKTOPS[@]} -eq 0 ]]; then
    echo "  No boki-managed TUIs found to remove."
    echo
    printf '  Press any key to close...'
    read -n1 -s
    exit 0
fi

# Build display list
declare -A NAME_TO_FILE
OPTIONS=""
for f in "${TUI_DESKTOPS[@]}"; do
    name=$(grep -oP '^Name=\K.*' "$f" | head -1)
    [[ -z "$name" ]] && name="$(basename "$f" .desktop)"
    NAME_TO_FILE["$name"]="$f"
    OPTIONS+="${name}\n"
done
OPTIONS="${OPTIONS%\\n}"

echo "  Select TUI to remove:"
echo
CHOSEN=$(echo -e "$OPTIONS" | fzf --prompt="Remove TUI > " --layout=reverse --border 2>/dev/null)

if [[ -z "$CHOSEN" ]]; then
    echo "  Cancelled."
    echo
    printf '  Press any key to close...'
    read -n1 -s
    exit 0
fi

DESKTOP_FILE="${NAME_TO_FILE[$CHOSEN]}"

echo
read -rp "  Remove '${CHOSEN}' (package + desktop entry)? [y/N] " confirm
if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
    echo "  Cancelled."
    echo
    printf '  Press any key to close...'
    read -n1 -s
    exit 0
fi

# Remove desktop entry first
rm -f "$DESKTOP_FILE"
update-desktop-database "$APPS_DIR" 2>/dev/null || true

# Attempt to remove the package
echo "  Removing package '${CHOSEN}'..."
if sudo pacman -Rns --noconfirm "$CHOSEN" 2>/dev/null; then
    echo "  ✓ Package removed."
else
    echo "  Package not found in pacman — may have been installed via AUR or manually."
    for aur in yay paru; do
        if command -v "$aur" &>/dev/null; then
            "$aur" -Rns --noconfirm "$CHOSEN" 2>/dev/null && echo "  ✓ Package removed via ${aur}." && break
        fi
    done
fi

echo
echo "  ✓ '${CHOSEN}' removed."
echo
printf '  Press any key to close...'
read -n1 -s
